# 로컬 전용 외부 API 인증키 예시. 실제 값은 git에 추적되지 않는 env.local.properties에 입력한다.
MY_SQL_END_POINT=localhost
MY_SQL_PORT=3306
MY_SQL_DB_NAME=nolate
MY_SQL_DB_USERNAME=nolate_user
MY_SQL_DB_PASSWORD=

JWT_SECRET_KEY=
JWT_ISSUER=nolate

# 일정/카테고리/공유 캘린더 기능. exact lowercase true만 활성화되며 false나 오타는
# 모든 공유 API와 공유 가시성을 fail closed 한다.
SCHEDULE_SHARING_ENABLED=true

# 공개 계정 삭제는 별도 본인확인 adapter와 보유정책·mailbox proof 승인 뒤 세 gate를 전환한다.
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_RETENTION_POLICY_CONFIRMED=false
# COMMON 가입에는 verified-email timestamp가 없으므로 현재 mailbox control을 계정 소유권
# 증거로 승인한 운영 환경에서만 true. enabled와 함께 무심코 전환하지 않는다.
ACCOUNT_DELETION_COMMON_MAILBOX_PROOF_POLICY_APPROVED=false
# JWT와 분리된 32바이트 이상의 무작위 비밀값. 저장소에는 실제 값을 커밋하지 않는다.
ACCOUNT_DELETION_HMAC_SECRET=
# 예: https://service.example.com (운영에서 canonical HTTPS origin을 명시)
ACCOUNT_DELETION_PUBLIC_ORIGIN=
# 운영 담당자가 실제 수신·본인확인 절차를 소유하는 주소
ACCOUNT_DELETION_SUPPORT_EMAIL=
ACCOUNT_DELETION_EMAIL_VERIFICATION_ENABLED=false
ACCOUNT_DELETION_EMAIL_FROM=
ACCOUNT_DELETION_SMTP_HOST=
ACCOUNT_DELETION_SMTP_PORT=587
ACCOUNT_DELETION_SMTP_USERNAME=
ACCOUNT_DELETION_SMTP_PASSWORD=
ACCOUNT_DELETION_SMTP_AUTH=true
ACCOUNT_DELETION_SMTP_STARTTLS_ENABLE=true
ACCOUNT_DELETION_SMTP_STARTTLS_REQUIRED=true
# 운영에서 email verifier 활성화 시 true: Spring Boot가 startup에 SMTP 연결을 검증
ACCOUNT_DELETION_SMTP_TEST_CONNECTION=false

GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=nolate-cbdf2
FIREBASE_CREDENTIALS_PATH=/config/firebase.json

SEOUL_OPENAPI_KEY=
SEOUL_SUBWAY_API_KEY=
SEOUL_BUS_API_KEY=
TAGO_API_KEY=
TAGO_BUS_API_KEY=
TMAP_ENABLED=false
TMAP_APP_KEY=

# 한국천문연구원 특일/음양력 공용 공공데이터포털 인증키
KASI_ENABLED=true
KASI_API_KEY=
KASI_BASE_URL=https://apis.data.go.kr/B090041/openapi/service

# SNS provider proof 검증용 공개 애플리케이션 식별자(비밀키가 아님)
SNS_KAKAO_APP_ID=
# Apple bundle/service client id를 comma-separated로 입력
SNS_APPLE_AUDIENCES=

# Sign in with Apple authorization-code exchange / account deletion revoke.
# APPLE_TOKEN_PRIVATE_KEY accepts the PEM with literal \n or base64:<base64-of-PEM>.
APPLE_TOKEN_LIFECYCLE_ENABLED=false
APPLE_TOKEN_CLIENT_ID=
APPLE_TOKEN_TEAM_ID=
APPLE_TOKEN_KEY_ID=
APPLE_TOKEN_PRIVATE_KEY=
APPLE_TOKEN_REDIRECT_URI=
# 32 random bytes, standard Base64. Never reuse JWT/database/provider keys.
APPLE_TOKEN_ENCRYPTION_KEY_ID=apple-token-v1
APPLE_TOKEN_ENCRYPTION_KEY=
# decrypt-only rotation entries: old-id=base64-key,older-id=base64-key
APPLE_TOKEN_PREVIOUS_ENCRYPTION_KEYS=
# Unbound encrypted captures become durable compensation work after this deadline.
APPLE_TOKEN_CAPTURE_BINDING_DEADLINE_SECONDS=120
APPLE_TOKEN_REVOCATION_WORKER_ENABLED=true
APPLE_TOKEN_REVOCATION_FIXED_DELAY_MS=30000
APPLE_TOKEN_REVOCATION_BATCH_SIZE=20
APPLE_TOKEN_REVOCATION_MAX_ATTEMPTS=12
APPLE_TOKEN_REVOCATION_RETRY_DELAY_SECONDS=60
APPLE_TOKEN_REVOCATION_MAX_RETRY_DELAY_SECONDS=21600
APPLE_TOKEN_REVOCATION_PROCESSING_TIMEOUT_SECONDS=120
